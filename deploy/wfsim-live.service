# THE OWNER'S LIVE BOARD on the board server — `scripts/live_board.sh`.
# Installed to /etc/systemd/system/; `scripts/ship_bot.py` ships its binaries
# and scripts to /opt/wfsim-bot/{bin,scripts}. /etc/wfsim-live.env holds the
# library's database — PG_URL (scripts/db.sh) — BOARD_PUSH_TOKEN and
# FACTORY_TOKEN. PG_URL reaches the server through `wfsim-pg-tunnel.service`.
[Unit]
Description=WFSim live board
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/wfsim-bot
EnvironmentFile=/etc/wfsim-live.env
ExecStart=/bin/bash scripts/live_board.sh /opt/wfsim-bot/live /opt/wfsim-bot/bin
# THE BOT ANSWERS FIRST: two cores serve both, and a projection can wait.
Nice=15
CPUWeight=20
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
