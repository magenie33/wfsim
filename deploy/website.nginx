map $http_accept $wfsim_markdown {
    default 0;
    ~*text/markdown 1;
}

map $request_uri $wfsim_path {
    default "";
    "~^(?<wfsim_original_path>[^?]*)" $wfsim_original_path;
}

map $wfsim_path $wfsim_twin {
    default "";
    / /index.md;
    /weapons /weapons.md;
    "~^/method(/[a-z]{2,3})?$" $wfsim_path.md;
    "~^/weapons/[^/.]+$" $wfsim_path.md;
}

map $wfsim_twin $wfsim_discovery_link {
    "" "";
    default "<$wfsim_twin>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </.well-known/api-catalog>; rel=\"api-catalog\", </.well-known/agent-skills/index.json>; rel=\"describedby\"; type=\"application/json\", </.well-known/mcp/server-card.json>; rel=\"service-desc\"; type=\"application/json\"";
}

map $wfsim_path $wfsim_md_page {
    default "";
    /index.md /;
    /weapons.md /weapons;
    "~^(?<wfsim_md_canonical_path>/weapons/[^/.]+|/method(?:/[a-z]{2,3})?)\\.md$" $wfsim_md_canonical_path;
}

map $wfsim_md_page $wfsim_canonical_link {
    "" "";
    default "<https://wfsim.app$wfsim_md_page>; rel=\"canonical\"";
}

server {
    listen 80;
    listen [::]:80;
    server_name wfsim.app www.wfsim.app;
    access_log off;
    error_log /dev/null;
    location ^~ /.well-known/acme-challenge/ {
        root /srv/wfsim/acme;
        try_files $uri =404;
    }
    location = /__health/release {
        alias /srv/wfsim/current/release.json;
        default_type application/json;
        add_header Cache-Control no-store;
    }
    location / { return 308 https://wfsim.app$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.wfsim.app;
    access_log off;
    error_log /dev/null;
    ssl_certificate /etc/letsencrypt/live/wfsim.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wfsim.app/privkey.pem;
    return 308 https://wfsim.app$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name wfsim.app;
    ssl_certificate /etc/letsencrypt/live/wfsim.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wfsim.app/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/wfsim/current;
    access_log off;
    error_log /dev/null;
    client_max_body_size 32m;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 4;
    gzip_types application/javascript application/json application/wasm text/css text/javascript text/markdown image/svg+xml;
    error_page 418 = @backend;

    location ~ ^/(api/|\.well-known/|board/|og/s/) { include /etc/nginx/wfsim-backend.conf; }
    location ~ ^/weapons/[^/]+/s/ { include /etc/nginx/wfsim-backend.conf; }
    location ~ ^/(board\.meta\.json|privacy|terms|refunds|auth\.md)$ { include /etc/nginx/wfsim-backend.conf; }
    location ~ ^/(asset|pkg|ocr|lib)/ {
        try_files $uri @previous_asset;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ~ ^/(img|pol|og)/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=604800";
    }
    location ~ \.md$ {
        default_type "text/markdown; charset=utf-8";
        try_files $uri =404;
        add_header Cache-Control no-cache;
        add_header Link $wfsim_canonical_link;
    }
    location ~ /\. { return 404; }
    location ~ ^/(_headers|_redirects|native/) { return 404; }
    location / {
        if ($uri ~ "^(.+)/$") { return 308 $1$is_args$args; }
        if ($wfsim_markdown) { return 418; }
        try_files $uri/index.html $uri /index.html;
        add_header Cache-Control "no-cache";
        add_header Vary Accept;
        add_header Link $wfsim_discovery_link;
    }
    location @backend { include /etc/nginx/wfsim-backend.conf; }
    location @previous_asset {
        root /srv/wfsim/previous;
        try_files $uri @missing_asset;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location @missing_asset {
        types { }
        default_type text/plain;
        return 404 "not found\n";
    }
}
