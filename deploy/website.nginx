map $http_accept $wfsim_markdown {
    default 0;
    ~*text/markdown 1;
}

server {
    listen 80;
    listen [::]:80;
    server_name wfsim.app www.wfsim.app;
    location ^~ /.well-known/acme-challenge/ {
        root /srv/wfsim/acme;
        try_files $uri =404;
    }
    location = /__health/release {
        alias /srv/wfsim/current/release.json;
        default_type application/json;
        add_header Cache-Control no-store;
    }
    location / { return 308 https://wfsim.app$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.wfsim.app;
    ssl_certificate /etc/letsencrypt/live/wfsim.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wfsim.app/privkey.pem;
    return 308 https://wfsim.app$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name wfsim.app;
    ssl_certificate /etc/letsencrypt/live/wfsim.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wfsim.app/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/wfsim/current;
    access_log off;
    error_log /var/log/nginx/wfsim-error.log warn;
    client_max_body_size 12m;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 4;
    gzip_types application/javascript application/json application/wasm text/css text/javascript text/markdown image/svg+xml;
    error_page 418 = @backend;

    location ~ ^/(api/|\.well-known/|board/|og/s/) { include /etc/nginx/wfsim-backend.conf; }
    location ~ ^/weapons/[^/]+/s/ { include /etc/nginx/wfsim-backend.conf; }
    location ~ ^/(board\.meta\.json|privacy|terms|refunds|auth\.md)$ { include /etc/nginx/wfsim-backend.conf; }
    location ~ ^/(asset|pkg|ocr|lib)/ {
        try_files $uri @previous_asset;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ~ ^/(img|pol|og)/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=604800";
    }
    location ~ \.md$ {
        default_type "text/markdown; charset=utf-8";
        try_files $uri =404;
        add_header Cache-Control no-cache;
    }
    location ~ /\. { return 404; }
    location ~ ^/(_headers|_redirects|native/) { return 404; }
    location / {
        if ($wfsim_markdown) { return 418; }
        try_files $uri/index.html $uri /index.html;
        add_header Cache-Control "no-cache";
    }
    location @backend { include /etc/nginx/wfsim-backend.conf; }
    location @previous_asset {
        root /srv/wfsim/previous;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
