# THE QQ BOT SERVER as a systemd unit — docs/AGENT.md §"The QQ bot".
# Installed to /etc/systemd/system/ on the bot server; the code lives in
# /opt/wfsim-bot (bot/, mcp/, site/pkg/) and the secrets in /etc/wfsim-bot.env.
[Unit]
Description=WFSim QQ bot
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/wfsim-bot
ExecStart=/usr/bin/node bot/qq.mjs
Restart=always
RestartSec=5
# THE BOT'S MEMORY IS ITS OWN: past MemoryHigh the kernel reclaims from this
# unit first, and past MemoryMax it kills inside it, never across the server.
# A killed renderer costs one card (bot/render.mjs answers in words instead).
MemoryHigh=1200M
MemoryMax=1600M
# Each browser's profile lives under /tmp, dropped with the unit.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
