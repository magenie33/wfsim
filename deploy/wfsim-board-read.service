# The ranking reader has its own runtime, credentials and bounded data work root.
[Unit]
Description=WFSim online ranking reader
After=network-online.target postgresql.service
Wants=network-online.target
RequiresMountsFor=/srv/wfsim-data

[Service]
User=wfsim-board
WorkingDirectory=/opt/wfsim-board-read
Environment=WFSIM_BOARD_STORAGE_REQUIRED=1
EnvironmentFile=/etc/wfsim-board-read.env
ExecStart=/usr/bin/node scripts/board_result_flow.mjs --source ${WFSIM_BOARD_READ_SOURCE} --bin ${WFSIM_BOARD_READ_BIN} --native-sha ${WFSIM_BOARD_READ_NATIVE_SHA} --work ${WFSIM_BOARD_WORK_ROOT}
Nice=15
CPUWeight=20
Restart=on-failure
RestartSec=10
TimeoutStopSec=330

[Install]
WantedBy=multi-user.target
