{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WFSim",
  "version": "2026.8.26",
  "identifier": "app.wfsim.desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "magenie33",
    "copyright": "AGPL-3.0-or-later",
    "shortDescription": "Warframe damage calculator, builder and optimizer",
    "longDescription": "WFSim — build, simulate and optimize Warframe weapons, matching in-game measurements.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "mainBinaryName": "wfsim-desktop"
}
