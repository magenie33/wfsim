// Cloudflare Workers (static assets) config — deploys site/ to wfsim.app.
//
// It was assets-ONLY (no script) until the board needed a submission endpoint.
// The three lines that changed are the three that matter:
//
//   main                     there is a script now, and it exists to add ONE
//                            path. Everything else it forwards untouched.
//   assets.binding           how the script forwards: `env.ASSETS.fetch(req)`
//                            serves the file exactly as the CDN did before.
//   assets.run_worker_first  WITHOUT THIS THE ENDPOINT CANNOT WORK. Assets are
//                            matched before the script runs, and
//                            `not_found_handling: single-page-application`
//                            answers every unmatched path with index.html — so
//                            /api/board/submit came back as the SPA with a 200,
//                            which is the quietest failure a client can get.
{
  "name": "wfsim",
  "compatibility_date": "2026-07-28",
  "main": "worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // Real-path routing: /weapons/<Wiki_Name> is a client-side route — any
    // unmatched path serves index.html and app.js's router resolves it.
    "not_found_handling": "single-page-application",
    // THE ADDRESS IS THE ONE WITHOUT THE SLASH, everywhere: the wiki page name
    // it mirrors, the canonical each page declares, every row of sitemap.xml,
    // and every link app.js writes. The default is `auto-trailing-slash`, which
    // 307s all 390 of those to a slashed twin — so each page's canonical named
    // a URL that redirects, and a TEMPORARY redirect is a search engine being
    // told not to move the signals across. This serves the declared address
    // and redirects the twin, which is the direction the whole site already
    // points.
    "html_handling": "drop-trailing-slash",
    // WHAT MUST NOT FALL THROUGH TO THE SPA. The api, because an endpoint that
    // answers with index.html and a 200 is the quietest failure a client can
    // get — and the two CONTENT-ADDRESSED prefixes for the same reason one step
    // down: a page cached from the previous build asks for a hashed file this
    // one has deleted, and HTML served under that name is executed as script.
    // The worker turns those into a real 404; see worker/index.js.
    // …AND A SHORT SHARE LINK, which the SPA fallback would answer with the
    // home page's HTML; the worker serves the weapon's own page for it.
    // …AND A SHORT LINK'S CARD, drawn by the worker rather than stored.
    // …AND EVERY PAGE WITH A MARKDOWN TWIN, which the worker serves to
    // `Accept: text/markdown`, AND THE TWIN ITSELF, which names its page as
    // canonical — and `.well-known/`, which is a document or a 404.
    "run_worker_first": ["/api/*", "/asset/*", "/pkg/*", "/", "/weapons", "/weapons/*",
                         "/index.md", "/weapons.md",
                         "/.well-known/*", "/og/s/*", "/auth.md", "/privacy", "/terms", "/refunds",
                         "/board/*", "/board.meta.json"]
  },
  // THE CARD'S FONTS ride in the bundle as bytes: a worker has no system fonts.
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  // WHERE EVERYTHING GOES. One database, and it is the only store: the library
  // of builds, the scores computed from it, and the money that has come in. A
  // KV namespace held the library and could not be asked a question about it —
  // no queries, no transactions, no bulk read, and listing
  // was the only index, metered at a thousand operations a DAY.
  //
  // IN THIS FILE AND NOT IN THE DASHBOARD: a wrangler deploy REPLACES the
  // worker's bindings with what the config declares, so a binding added through
  // the dashboard is removed by the next push.
  //
  // The id is an IDENTIFIER, not a secret — it grants nothing without an api
  // token, and Cloudflare's own docs commit it. It takes the bare product name
  // because ONE database holds every table this product has: docs/NAMING.md §8.
  //
  //   npx wrangler d1 create wfsim
  //   npx wrangler d1 execute wfsim --remote --file worker/schema.sql
  "d1_databases": [
    {
      "binding": "LIBRARY",
      "database_name": "wfsim",
      "database_id": "0fdd0713-cdd6-44ff-af38-efe6978c9e52"
    },
    // …EXCEPT THE ACCOUNTS, which are personal data: a database of their own,
    // so a point-in-time restore of either never rolls the other back and
    // nothing in it can reach the public library backup (docs/ACCOUNTS.md).
    {
      "binding": "ACCOUNTS",
      "database_name": "wfsim-accounts",
      "database_id": "ad0765fa-bf84-4cb9-95a1-4bd5b297b864"
    }
  ],
  // HOW OFTEN ONE ADDRESS MAY ASK FOR A LOGIN CODE — the mail costs money and
  // lands in somebody's inbox. Keyed by the caller's IP, which is not stored.
  // THE LOGIN CODE'S MAIL, through Cloudflare Email Service from the onboarded
  // `wfsim.app` (docs/ACCOUNTS.md §Setup). Absent, email is not offered.
  "send_email": [{ "name": "EMAIL" }],
  // THE PAID HALF: a private worker, the only way to reach it (worker/cloud.js).
  "services": [{ "binding": "CLOUD", "service": "wfsim-cloud" }],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // HOW OFTEN ONE ADDRESS MAY OFFER A SCREENSHOT (worker/ocr_samples.js).
    { "name": "OCR_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    // HOW OFTEN ONE ACCOUNT MAY ASK FOR A CLAN INVITE (worker/clan.js).
    { "name": "CLAN_LIMIT", "namespace_id": "1003", "simple": { "limit": 1, "period": 60 } }
  ],
  // THE PRODUCT'S ONE BUCKET (docs/NAMING.md §8): the screenshots readers offer,
  // under `ocr-samples/`, kept 365 days by the bucket's own lifecycle rule —
  //   npx wrangler r2 bucket lifecycle add wfsim ocr-samples-365 ocr-samples/ --expire-days 365
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "wfsim" }],
  // WHAT READERS DID — `POST /api/e`, docs/ANALYTICS.md. A dataset is created by
  // its first write; nothing to provision. Read back by `scripts/usage.py`.
  "analytics_engine_datasets": [
    { "binding": "USAGE", "dataset": "wfsim" }
  ],
  // KEEPING THE USAGE DAYS (worker/usage_days.js): after midnight UTC, so the
  // day before is finished. Reads the dataset with the secrets USAGE_ACCOUNT and
  // USAGE_READ_TOKEN (Account Analytics: Read); without them it does nothing.
  "triggers": { "crons": ["30 0 * * *"] }
}
