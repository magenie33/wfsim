// Cloudflare Workers (static assets) config — deploys site/ to wfsim.app.
//
// It was assets-ONLY (no script) until the board needed a submission endpoint.
// The three lines that changed are the three that matter:
//
//   main                     there is a script now, and it exists to add ONE
//                            path. Everything else it forwards untouched.
//   assets.binding           how the script forwards: `env.ASSETS.fetch(req)`
//                            serves the file exactly as the CDN did before.
//   assets.run_worker_first  WITHOUT THIS THE ENDPOINT CANNOT WORK. Assets are
//                            matched before the script runs, and
//                            `not_found_handling: single-page-application`
//                            answers every unmatched path with index.html — so
//                            /api/board/submit came back as the SPA with a 200,
//                            which is the quietest failure a client can get.
{
  "name": "wfsim",
  "compatibility_date": "2026-07-28",
  "main": "worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // Real-path routing: /weapons/<Wiki_Name> is a client-side route — any
    // unmatched path serves index.html and app.js's router resolves it.
    "not_found_handling": "single-page-application",
    // THE ADDRESS IS THE ONE WITHOUT THE SLASH, everywhere: the wiki page name
    // it mirrors, the canonical each page declares, every row of sitemap.xml,
    // and every link app.js writes. The default is `auto-trailing-slash`, which
    // 307s all 390 of those to a slashed twin — so each page's canonical named
    // a URL that redirects, and a TEMPORARY redirect is a search engine being
    // told not to move the signals across. This serves the declared address
    // and redirects the twin, which is the direction the whole site already
    // points.
    "html_handling": "drop-trailing-slash",
    // The api is the one thing that must NOT fall through to the SPA.
    "run_worker_first": ["/api/*"]
  },
  // WHERE EVERYTHING GOES. One database, and it is the only store: the library
  // of builds, the scores computed from it, and the money that has come in. A
  // KV namespace held the library and could not be asked a question about it —
  // no queries, no transactions, no bulk read, and listing
  // was the only index, metered at a thousand operations a DAY.
  //
  // IN THIS FILE AND NOT IN THE DASHBOARD: a wrangler deploy REPLACES the
  // worker's bindings with what the config declares, so a binding added through
  // the dashboard is removed by the next push.
  //
  // The id is an IDENTIFIER, not a secret — it grants nothing without an api
  // token, and Cloudflare's own docs commit it. It takes the bare product name
  // because ONE database holds every table this product has: docs/NAMING.md §8.
  //
  //   npx wrangler d1 create wfsim
  //   npx wrangler d1 execute wfsim --remote --file worker/schema.sql
  //   npx wrangler d1 execute wfsim --remote --file ledger/schema.sql
  "d1_databases": [
    {
      "binding": "LIBRARY",
      "database_name": "wfsim",
      "database_id": "0fdd0713-cdd6-44ff-af38-efe6978c9e52"
    }
  ]
}
