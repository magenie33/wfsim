<script>(RLQ=window.RLQ||[]).push(function(){mw.config.set({"wgHostname":"mediawiki-b8bd54484-26bbz","wgBackendResponseTime":35});});</script>

<script>
( () => {
    const initTime = performance.now();
    const reportFn = p => ( fetch( "https://weirdgloop.org/ai-scrapers-suck", {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify( {
            ray: "a253d625eecd2b9b",
            time: performance.now() - initTime,
            ...p,
        } ),
    } ) );
    let cancelFurther = false;
    const callback = e => {
        removeEventListener( e.type, callback );

        if ( cancelFurther ) {
            return;
        }
        cancelFurther = true;

        let data = {};
        if ( event.type.indexOf( 'pointer' ) === 0 ) {
            data = {
                pointerType: e.pointerType,
                x: e.clientX,
                y: e.clientY,
                sx: e.screenX,
                sy: e.screenY,
                dx: e.movementX,
                dy: e.movementY,
            };
        }

        reportFn( {
            type: e.type,
            isTrusted: e.isTrusted,
            area: !( e.target && e.target.closest ) ? null :
                !!e.target.closest( '#content' ) ? 'content' :
                !!e.target.closest( '#mw-panel' ) ? 'panel' :
                !!e.target.closest( '#mw-head' ) ? 'head' :
                !!e.target.closest( '#footer' ) ? 'footer' :
                ( e.target.closest( '[id]' )?.id ?? e.target.tagName ),
            ...data,
        } );
    };
    for ( const event of ["pointermove","pointerdown","pointerup","pointerover","keydown"] ) {
        addEventListener( event, callback, { passive: true } );
    }
    
} )();
</script>
