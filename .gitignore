# Rust
/target
**/*.rs.bk
Cargo.lock.orig

# mise
.mise.local.toml

# Python (scripts/)
__pycache__/
*.pyc

# Cached weapon/mod/arcane art (runtime cache, pre-warmed by fetch_images.py;
# DE art is never committed — served via the /img proxy with WFCD fallback).
web/cache/

# Private, never committed
/private/

# Vendored reference datasets (fetched by scripts/vendor.py; MIT-licensed
# upstream, never committed here)
/vendor/

# Editor / OS
.idea/
.vscode/
.claude/
*.swp
.DS_Store
Thumbs.db
# Scratch cargo target dirs (CARGO_TARGET_DIR=target-<something> for a build
# that must not disturb the main one). `git add -A` picked one up as 5,500
# files once; the glob is what stops the next one.
target-*/

# wrangler's local state cache — written by any `wrangler kv`/`dev` run,
# machine-local and never part of a deploy (the deploy is a push to main).
.wrangler/

# one-shot data generators: they run once, and what they decided is in docs/
.scan/
.probe/

# The desktop shell is its own cargo workspace, so the root `/target` rule does
# not reach it.
/desktop/target

# Installers and the source archive that ships beside them. Built by
# `scripts/build_desktop.py`, uploaded to the network drive, never committed —
# a 30 MB binary per release is not what a git history is for.
/dist
